# ── Notion: integración interna (modo un solo usuario) ──
NOTION_TOKEN=ntn_xxx
NOTION_DEFAULT_PAGE_ID=00000000000000000000000000000000
# Opcional: nombre que muestra la píldora superior (si no, se detecta desde Notion)
NOTION_USER_NAME=

# ── Notion: integración pública (OAuth, botón "Conectar con Notion") ──
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Mínimo 32 caracteres aleatorios: openssl rand -base64 32
SESSION_SECRET=
# Opcional: fuerza el origen usado en la redirect URI (p. ej. https://senda.vercel.app)
APP_URL=

# ── IA ──
GEMINI_API_KEY=
CLAUDE_API_KEY=
# Opcionales: cambiar de modelo sin tocar código
# Separar con comas para definir la cadena de respaldo
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
CLAUDE_MODEL=claude-sonnet-5-5
