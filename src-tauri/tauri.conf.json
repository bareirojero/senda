{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senda",
  "version": "1.2.0",
  "identifier": "com.bareirojero.senda",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Senda",
        "url": "https://senda-nu-bay.vercel.app",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
